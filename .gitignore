# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/
**/build/

# Gradle files
.gradle/
**/.gradle/
build/

# Local configuration file (SDK path, secrets)
local.properties

# Android Studio / IntelliJ
.idea/
*.iml
*.iws
*.ipr
captures/
.navigation/

# Keystore (never commit secrets)
*.jks
*.keystore
keystore.properties

# Kotlin
.kotlin/

# Logs / crash dumps
*.log
hs_err_pid*
replay_pid*

# BlueJ / J2ME
*.ctxt
.mtj.tmp/

# Archives
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Profiling / memory dumps
*.hprof

# OS files
.DS_Store
Thumbs.db

# IMPORTANT: the Gradle wrapper jar MUST be committed despite the broad
# package-file ignore below (negation is placed after it on purpose).
*.jar
*.nar
!gradle/wrapper/gradle-wrapper.jar

# Committed release artifacts — intentionally track shipped APKs under releases/
!releases/*.apk
